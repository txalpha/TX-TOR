<Window x:Class="TxTorBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TX TOR — Premium Super Fast Browser" Height="760" Width="1200"
        Background="{StaticResource BrushBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Tabs Bar -->
            <RowDefinition Height="40" />
            <!-- Navigation Address Bar -->
            <RowDefinition Height="50" />
            <!-- Browser Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Tabs Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="#33A855F7" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnNewTab" Content="+" Width="32" Height="28" Margin="8,0" 
                        Background="#33A855F7" Foreground="White" BorderThickness="0" Click="BtnNewTab_Click" />
                <ItemsControl x:Name="TabList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1B0E36" BorderBrush="#55A855F7" BorderThickness="1" 
                                    CornerRadius="6,6,0,0" Margin="4,4,4,0" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="White" Width="120" TextTrimming="CharacterEllipsis" />
                                    <Button Content="✕" Foreground="#7E8B9B" Background="Transparent" BorderThickness="0" Margin="6,0,0,0"
                                            CommandParameter="{Binding Id}" Click="BtnCloseTab_Click" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Address / Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BrushBackground}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BtnBack" Content="◀" Width="36" Height="36" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnBack_Click" />
                    <Button x:Name="BtnForward" Content="▶" Width="36" Height="36" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnForward_Click" />
                    <Button x:Name="BtnReload" Content="⟳" Width="36" Height="36" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnReload_Click" />
                </StackPanel>

                <!-- URL Omnibox -->
                <Border Grid.Column="1" Background="{StaticResource BrushSurface}" CornerRadius="18" BorderBrush="#55A855F7" BorderThickness="1" Padding="12,0">
                    <TextBox x:Name="TxtUrl" VerticalAlignment="Center" Background="Transparent" Foreground="White" BorderThickness="0"
                             FontSize="14" KeyDown="TxtUrl_KeyDown" />
                </Border>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="BtnDesktopMode" Content="🖥 Desktop" Margin="4,0" Padding="8,4" Background="#1B0E36" Foreground="#06B6D4" BorderBrush="#06B6D4" BorderThickness="1" Click="BtnDesktopMode_Click" />
                    <Button x:Name="BtnDownloads" Content="⬇ Downloads" Margin="4,0" Padding="8,4" Background="{StaticResource BrushPurpleGradient}" Foreground="White" BorderThickness="0" Click="BtnDownloads_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Engine Container -->
        <Border Grid.Row="2" Background="{StaticResource BrushBackground}">
            <wv2:WebView2 x:Name="WebViewControl" Source="https://www.google.com" />
        </Border>
    </Grid>
</Window>
