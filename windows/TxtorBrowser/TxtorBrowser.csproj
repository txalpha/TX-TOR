<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\txtor.ico</ApplicationIcon>
    <AssemblyName>TxTorBrowser</AssemblyName>
    <RootNamespace>TxTorBrowser</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>TX TOR Architecture</Authors>
    <Company>TX TOR</Company>
    <Description>TX TOR — Premium Super Fast Glassmorphic Browser for Windows with Edge WebView2</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
  </ItemGroup>

</Project>
